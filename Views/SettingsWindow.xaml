<Window x:Class="WinUtil.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="WinUtil settings"
        Width="880"
        Height="620"
        MinWidth="720"
        MinHeight="520"
        Background="{StaticResource CanvasBrush}"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <sys:Double x:Key="MinimumBackgroundOpacity">0.55</sys:Double>
    <sys:Double x:Key="MinimumFadedOpacity">0.10</sys:Double>
    <sys:Double x:Key="MinimumWidgetOpacity">0.55</sys:Double>
    <sys:Double x:Key="MaximumFadedOpacity">0.90</sys:Double>
    <sys:Double x:Key="MaximumOpacity">1.0</sys:Double>
    <sys:Double x:Key="MaximumPasswordLength">64</sys:Double>
    <sys:Double x:Key="MinimumPasswordLength">8</sys:Double>
    <sys:Double x:Key="OpacityTickFrequency">0.05</sys:Double>

    <Style x:Key="WidgetNavigationItem" TargetType="ListBoxItem">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="ItemBorder"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="1">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceInteractiveBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentMutedBrush}" />
                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource TextPrimaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="24" />
      <RowDefinition Height="*" />
      <RowDefinition Height="24" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Width="4"
              Height="28"
              VerticalAlignment="Center"
              Background="{StaticResource AccentBrush}" />
      <TextBlock Grid.Column="2"
                 VerticalAlignment="Center"
                 FontFamily="Segoe UI Variable Display"
                 FontSize="24"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource TextPrimaryBrush}"
                 Text="Settings" />
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="160" />
        <ColumnDefinition Width="32" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock FontFamily="Cascadia Mono"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     Text="WIDGET" />
          <ListBox x:Name="SettingsNavigationListBox"
                    Grid.Row="2"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource WidgetNavigationItem}"
                   SelectionChanged="HandleWidgetNavigationSelectionChanged"
                   AutomationProperties.Name="Widget settings">
            <ListBoxItem>
              <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Cascadia Mono"
                           FontSize="11"
                           Foreground="{StaticResource AccentBrush}"
                           Text="W" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="Desktop widget" />
              </Grid>
            </ListBoxItem>
          </ListBox>
          <TextBlock Grid.Row="4"
                     FontFamily="Cascadia Mono"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     Text="SPOTLIGHT" />
          <ListBox x:Name="SpotlightNavigationListBox"
                   Grid.Row="6"
                   Background="Transparent"
                   BorderThickness="0"
                   ItemContainerStyle="{StaticResource WidgetNavigationItem}"
                   SelectionChanged="HandleSpotlightNavigationSelectionChanged"
                   AutomationProperties.Name="Spotlight settings">
            <ListBoxItem>
              <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Cascadia Mono"
                           FontSize="11"
                           Foreground="{StaticResource AccentBrush}"
                           Text="U" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="UUID" />
              </Grid>
            </ListBoxItem>
            <ListBoxItem>
              <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Cascadia Mono"
                           FontSize="11"
                           Foreground="{StaticResource AccentBrush}"
                           Text="P" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="Password" />
              </Grid>
            </ListBoxItem>
            <ListBoxItem>
              <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Cascadia Mono"
                           FontSize="11"
                           Foreground="{StaticResource AccentBrush}"
                           Text="J" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="JWT secret" />
              </Grid>
            </ListBoxItem>
            <ListBoxItem>
              <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Cascadia Mono"
                           FontSize="11"
                           Foreground="{StaticResource AccentBrush}"
                           Text="F" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="Text tools" />
              </Grid>
            </ListBoxItem>
          </ListBox>
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="2"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel>
        <StackPanel x:Name="WidgetSettingsPanel">
        <TextBlock FontFamily="Segoe UI Variable Display"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Text="Desktop widget" />

        <Grid Margin="0,24,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <CheckBox x:Name="KeepOnTopCheckBox"
                    Style="{StaticResource SettingsCheckBox}"
                    Content="Keep above other windows"
                    FontSize="15" />
          <CheckBox x:Name="ShowSecondsCheckBox"
                    Grid.Column="1"
                    Style="{StaticResource SettingsCheckBox}"
                    Content="Show seconds"
                    FontSize="15" />
        </Grid>

        <Border Margin="0,24,0,0"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" />

        <Grid Margin="0,24,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="AutoHideDelayLabel"
                     VerticalAlignment="Center"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     Text="Fade after" />
          <ComboBox x:Name="AutoHideDelayComboBox"
                    Grid.Column="1"
                    MinWidth="132"
                    Style="{StaticResource SettingsComboBox}"
                    AutomationProperties.LabeledBy="{Binding ElementName=AutoHideDelayLabel}">
            <ComboBoxItem Content="10 seconds" />
            <ComboBoxItem Content="20 seconds" />
          </ComboBox>
        </Grid>

        <Border Margin="0,24,0,0"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" />

        <Grid Margin="0,24,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="OpacityLabel"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Text="Widget opacity" />
            <TextBlock x:Name="OpacityValueText"
                       Grid.Column="1"
                       FontFamily="Cascadia Mono"
                       FontSize="14"
                       Foreground="{StaticResource AccentBrush}"
                       Text="100%" />
          </Grid>
          <Slider x:Name="OpacitySlider"
                  Grid.Row="2"
                  Minimum="{StaticResource MinimumWidgetOpacity}"
                  Maximum="{StaticResource MaximumOpacity}"
                  TickFrequency="{StaticResource OpacityTickFrequency}"
                  IsSnapToTickEnabled="True"
                  Style="{StaticResource SettingsSlider}"
                  ValueChanged="HandleOpacityValueChanged"
                  AutomationProperties.LabeledBy="{Binding ElementName=OpacityLabel}" />

          <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="BackgroundOpacityLabel"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Text="Background opacity" />
            <TextBlock x:Name="BackgroundOpacityValueText"
                       Grid.Column="1"
                       FontFamily="Cascadia Mono"
                       FontSize="14"
                       Foreground="{StaticResource AccentBrush}"
                       Text="100%" />
          </Grid>
          <Slider x:Name="BackgroundOpacitySlider"
                  Grid.Row="6"
                  Minimum="{StaticResource MinimumBackgroundOpacity}"
                  Maximum="{StaticResource MaximumOpacity}"
                  TickFrequency="{StaticResource OpacityTickFrequency}"
                  IsSnapToTickEnabled="True"
                  Style="{StaticResource SettingsSlider}"
                  ValueChanged="HandleBackgroundOpacityValueChanged"
                  AutomationProperties.LabeledBy="{Binding ElementName=BackgroundOpacityLabel}" />

          <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FadedOpacityLabel"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Text="Faded opacity" />
            <TextBlock x:Name="FadedOpacityValueText"
                       Grid.Column="1"
                       FontFamily="Cascadia Mono"
                       FontSize="14"
                       Foreground="{StaticResource AccentBrush}"
                       Text="10%" />
          </Grid>
          <Slider x:Name="FadedOpacitySlider"
                  Grid.Row="10"
                  Minimum="{StaticResource MinimumFadedOpacity}"
                  Maximum="{StaticResource MaximumFadedOpacity}"
                  TickFrequency="{StaticResource OpacityTickFrequency}"
                  IsSnapToTickEnabled="True"
                  Style="{StaticResource SettingsSlider}"
                  ValueChanged="HandleFadedOpacityValueChanged"
                  AutomationProperties.LabeledBy="{Binding ElementName=FadedOpacityLabel}" />
        </Grid>
        </StackPanel>

        <StackPanel x:Name="UuidSettingsPanel"
                    Visibility="Collapsed">
          <TextBlock FontFamily="Segoe UI Variable Display"
                     FontSize="22"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     Text="UUID" />
          <TextBlock Margin="0,4,0,0"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     Text="Choose the UUID version generated by Spotlight." />

          <Grid Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="UuidVersionLabel"
                         FontSize="15"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         Text="UUID version" />
              <TextBlock Margin="0,4,0,0"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         Text="Version 7 sorts by creation time; Version 4 is random." />
            </StackPanel>
            <ComboBox x:Name="UuidVersionComboBox"
                      Grid.Column="1"
                      MinWidth="180"
                      Style="{StaticResource SettingsComboBox}"
                      AutomationProperties.LabeledBy="{Binding ElementName=UuidVersionLabel}">
              <ComboBoxItem Content="Version 4 — random" />
              <ComboBoxItem Content="Version 7 — ordered" />
            </ComboBox>
          </Grid>
          <Border Margin="0,24,0,0"
                  Padding="0,20,0,0"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="0,1,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="UuidShortcutLabel"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Text="Optional global shortcut" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Runs Generate UUID from any app and overrides the matching app shortcut." />
              </StackPanel>
              <StackPanel Grid.Column="1"
                          Orientation="Horizontal">
                <TextBox x:Name="UuidShortcutTextBox"
                         Width="156"
                         Height="36"
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         Background="{StaticResource SurfaceRaisedBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         IsReadOnly="True"
                         Tag="uuid"
                         GotKeyboardFocus="HandleShortcutCaptureGotKeyboardFocus"
                         LostKeyboardFocus="HandleShortcutCaptureLostKeyboardFocus"
                         AutomationProperties.HelpText="Click and press the physical key combination to assign the UUID shortcut."
                         AutomationProperties.LabeledBy="{Binding ElementName=UuidShortcutLabel}" />
                <Button Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButton}"
                        Tag="uuid"
                        Content="Clear"
                        Click="HandleClearShortcut" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>

        <StackPanel x:Name="PasswordSettingsPanel"
                    Visibility="Collapsed">
          <TextBlock FontFamily="Segoe UI Variable Display"
                     FontSize="22"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     Text="Password" />
          <TextBlock Margin="0,4,0,0"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     Text="Choose the length and characters generated by Spotlight." />
          <Grid Margin="0,24,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="12" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="20" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="12" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="PasswordLengthLabel"
                         FontSize="15"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         Text="Password length" />
              <TextBlock x:Name="PasswordLengthValueText"
                         Grid.Column="1"
                         FontFamily="Cascadia Mono"
                         FontSize="14"
                         Foreground="{StaticResource AccentBrush}"
                         Text="20 characters" />
            </Grid>
            <Slider x:Name="PasswordLengthSlider"
                    Grid.Row="2"
                    Minimum="{StaticResource MinimumPasswordLength}"
                    Maximum="{StaticResource MaximumPasswordLength}"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    Style="{StaticResource SettingsSlider}"
                    ValueChanged="HandlePasswordLengthValueChanged"
                    AutomationProperties.LabeledBy="{Binding ElementName=PasswordLengthLabel}" />

            <TextBlock Grid.Row="4"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Text="Include characters" />
            <Grid Grid.Row="6">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <CheckBox x:Name="PasswordIncludesUppercaseCheckBox"
                        Style="{StaticResource SettingsCheckBox}"
                        Content="Uppercase letters (A–Z)"
                        FontSize="15"
                        Checked="HandlePasswordCharacterSetChanged"
                        Unchecked="HandlePasswordCharacterSetChanged" />
              <CheckBox x:Name="PasswordIncludesLowercaseCheckBox"
                        Grid.Column="1"
                        Style="{StaticResource SettingsCheckBox}"
                        Content="Lowercase letters (a–z)"
                        FontSize="15"
                        Checked="HandlePasswordCharacterSetChanged"
                        Unchecked="HandlePasswordCharacterSetChanged" />
              <CheckBox x:Name="PasswordIncludesDigitsCheckBox"
                        Grid.Row="2"
                        Style="{StaticResource SettingsCheckBox}"
                        Content="Numbers (2–9)"
                        FontSize="15"
                        Checked="HandlePasswordCharacterSetChanged"
                        Unchecked="HandlePasswordCharacterSetChanged" />
              <CheckBox x:Name="PasswordIncludesSymbolsCheckBox"
                        Grid.Row="2"
                        Grid.Column="1"
                        Style="{StaticResource SettingsCheckBox}"
                        Content="Symbols (! @ # $ - _)"
                        FontSize="15"
                        Checked="HandlePasswordCharacterSetChanged"
                        Unchecked="HandlePasswordCharacterSetChanged" />
              <TextBlock x:Name="PasswordCharacterSetErrorText"
                         Grid.Row="4"
                         Grid.ColumnSpan="2"
                         Foreground="{StaticResource ErrorBrush}"
                         Text="Select at least one character group."
                         Visibility="Collapsed" />
            </Grid>
          </Grid>
          <Border Margin="0,24,0,0"
                  Padding="0,20,0,0"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="0,1,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="PasswordShortcutLabel"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Text="Optional global shortcut" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Runs Generate password from any app and overrides the matching app shortcut." />
              </StackPanel>
              <StackPanel Grid.Column="1"
                          Orientation="Horizontal">
                <TextBox x:Name="PasswordShortcutTextBox"
                         Width="156"
                         Height="36"
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         Background="{StaticResource SurfaceRaisedBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         IsReadOnly="True"
                         Tag="password"
                         GotKeyboardFocus="HandleShortcutCaptureGotKeyboardFocus"
                         LostKeyboardFocus="HandleShortcutCaptureLostKeyboardFocus"
                         AutomationProperties.HelpText="Click and press the physical key combination to assign the password shortcut."
                         AutomationProperties.LabeledBy="{Binding ElementName=PasswordShortcutLabel}" />
                <Button Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButton}"
                        Tag="password"
                        Content="Clear"
                        Click="HandleClearShortcut" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
        <StackPanel x:Name="JwtSecretSettingsPanel"
                    Visibility="Collapsed">
          <TextBlock FontFamily="Segoe UI Variable Display"
                     FontSize="22"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     Text="JWT secret" />
          <TextBlock Margin="0,4,0,0"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     Text="Choose the entropy for the Base64URL secret generated by Spotlight." />
          <Grid Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="JwtSecretStrengthLabel"
                         FontSize="15"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         Text="Secret strength" />
              <TextBlock Margin="0,4,0,0"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         Text="256-bit is suitable for HS256; choose a larger value only if your service needs it." />
            </StackPanel>
            <ComboBox x:Name="JwtSecretStrengthComboBox"
                      Grid.Column="1"
                      MinWidth="180"
                      Style="{StaticResource SettingsComboBox}"
                      AutomationProperties.LabeledBy="{Binding ElementName=JwtSecretStrengthLabel}">
              <ComboBoxItem Content="256-bit — recommended" />
              <ComboBoxItem Content="384-bit" />
              <ComboBoxItem Content="512-bit" />
            </ComboBox>
          </Grid>
          <Border Margin="0,24,0,0"
                  Padding="0,20,0,0"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="0,1,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="JwtSecretShortcutLabel"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Text="Optional global shortcut" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Runs Generate JWT secret from any app and overrides the matching app shortcut." />
              </StackPanel>
              <StackPanel Grid.Column="1"
                          Orientation="Horizontal">
                <TextBox x:Name="JwtSecretShortcutTextBox"
                         Width="156"
                         Height="36"
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         Background="{StaticResource SurfaceRaisedBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         IsReadOnly="True"
                         Tag="jwt-secret"
                         GotKeyboardFocus="HandleShortcutCaptureGotKeyboardFocus"
                         LostKeyboardFocus="HandleShortcutCaptureLostKeyboardFocus"
                         AutomationProperties.HelpText="Click and press the physical key combination to assign the JWT secret shortcut."
                         AutomationProperties.LabeledBy="{Binding ElementName=JwtSecretShortcutLabel}" />
                <Button Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButton}"
                        Tag="jwt-secret"
                        Content="Clear"
                        Click="HandleClearShortcut" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
        <StackPanel x:Name="TextToolsSettingsPanel"
                    Visibility="Collapsed">
          <TextBlock FontFamily="Segoe UI Variable Display"
                     FontSize="22"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     Text="Text tools" />
          <TextBlock Margin="0,4,0,0"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     Text="Transform selected text in the active app. Each shortcut overrides the matching app command." />
          <Grid Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock FontSize="15"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         Text="Format JSON" />
              <TextBlock Margin="0,4,0,0"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         Text="Pretty-print selected JSON." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <TextBox x:Name="FormatJsonShortcutTextBox"
                       Width="156" Height="36" Padding="10,0"
                       VerticalContentAlignment="Center"
                       Background="{StaticResource SurfaceRaisedBrush}"
                       BorderBrush="{StaticResource BorderBrush}"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       IsReadOnly="True" Tag="format-json"
                       GotKeyboardFocus="HandleShortcutCaptureGotKeyboardFocus"
                       LostKeyboardFocus="HandleShortcutCaptureLostKeyboardFocus"
                       AutomationProperties.Name="Format JSON shortcut"
                       AutomationProperties.HelpText="Click and press the physical key combination to assign the Format JSON shortcut." />
              <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                      Tag="format-json" Content="Clear" Click="HandleClearShortcut" />
            </StackPanel>
          </Grid>
          <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="Minify JSON" />
              <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="Remove insignificant JSON whitespace." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
