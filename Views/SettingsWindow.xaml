<Window x:Class="WinUtil.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:controls="clr-namespace:WinUtil.Views.Controls"
        xmlns:viewModels="clr-namespace:WinUtil.ViewModels"
        Title="WinUtil settings"
        Width="960"
        Height="720"
        MinWidth="820"
        MinHeight="600"
        Background="{StaticResource CanvasBrush}"
        FontFamily="{StaticResource BodyFont}"
        FontSize="{StaticResource FontSizeBody}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <sys:Double x:Key="MinimumBackgroundOpacity">0.55</sys:Double>
    <sys:Double x:Key="MinimumFadedOpacity">0.10</sys:Double>
    <sys:Double x:Key="MinimumWidgetOpacity">0.55</sys:Double>
    <sys:Double x:Key="MaximumFadedOpacity">0.90</sys:Double>
    <sys:Double x:Key="MaximumOpacity">1.0</sys:Double>
    <sys:Double x:Key="MaximumPasswordLength">64</sys:Double>
    <sys:Double x:Key="MinimumPasswordLength">8</sys:Double>
    <sys:Double x:Key="OpacityTickFrequency">0.05</sys:Double>

    <Style x:Key="NavigationItem" TargetType="ListBoxItem">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="ItemBorder"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    SnapsToDevicePixels="True">
              <Grid>
                <Border x:Name="SelectionBar"
                        Width="3"
                        Margin="0,7"
                        HorizontalAlignment="Left"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="1.5"
                        Visibility="Collapsed" />
                <ContentPresenter Margin="{TemplateBinding Padding}"
                                  VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceInteractiveBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentMutedBrush}" />
                <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource TextPrimaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavigationListBox" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,24" />
      <Setter Property="ItemContainerStyle" Value="{StaticResource NavigationItem}" />
    </Style>

    <Style x:Key="PageHeader" TargetType="StackPanel">
      <Setter Property="Margin" Value="0,0,0,28" />
    </Style>

    <Style x:Key="SettingsGroupHeading" TargetType="TextBlock" BasedOn="{StaticResource SubtitleText}">
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="SettingsGroup" TargetType="Border">
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
    </Style>

    <Style x:Key="ClearButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <Style x:Key="SliderValueText" TargetType="TextBlock" BasedOn="{StaticResource ValueText}">
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="SliderRow" TargetType="StackPanel">
      <Setter Property="Margin" Value="0,10" />
    </Style>

    <DataTemplate DataType="{x:Type viewModels:ShortcutSettingViewModel}">
      <StackPanel Orientation="Horizontal">
        <TextBox Style="{StaticResource ShortcutTextBox}"
                 Tag="{Binding ActionId}"
                 Text="{Binding DisplayText, Mode=OneWay}"
                 GotKeyboardFocus="HandleShortcutCaptureGotKeyboardFocus"
                 LostKeyboardFocus="HandleShortcutCaptureLostKeyboardFocus"
                 AutomationProperties.Name="{Binding Title, StringFormat={}{0} shortcut}"
                 AutomationProperties.HelpText="{Binding AutomationHelpText}" />
        <Button Style="{StaticResource ClearButton}"
                Tag="{Binding ActionId}"
                Content="Clear"
                IsEnabled="{Binding IsAssigned}"
                Click="HandleClearShortcut" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ShortcutGroupRow" DataType="{x:Type viewModels:ShortcutSettingViewModel}">
      <StackPanel>
        <Border x:Name="RowDivider" Style="{StaticResource CardDivider}" />
        <controls:SettingRow Title="{Binding Title}"
                             Description="{Binding Description}"
                             Content="{Binding}" />
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}" Value="0">
          <Setter TargetName="RowDivider" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewModels:ShortcutSettingGroup}">
      <StackPanel Margin="0,0,0,20">
        <TextBlock Margin="0,0,0,8" Style="{StaticResource SubtitleText}" Text="{Binding Title}" />
        <Border Style="{StaticResource SettingsGroup}">
          <ItemsControl AlternationCount="1000"
                        Focusable="False"
                        ItemTemplate="{StaticResource ShortcutGroupRow}"
                        ItemsSource="{Binding Shortcuts}" />
        </Border>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid Background="{StaticResource CanvasBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="196" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Background="{StaticResource SurfaceBrush}" Padding="12,24"
            BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
      <StackPanel>
        <TextBlock Margin="12,0,0,28"
                   Style="{StaticResource SubtitleText}"
                   Text="WinUtil" />

        <TextBlock Margin="12,0,0,8" Style="{StaticResource SectionLabelText}" Text="General" />
        <ListBox x:Name="SettingsNavigationListBox"
                 Style="{StaticResource NavigationListBox}"
                 SelectionChanged="HandleWidgetNavigationSelectionChanged"
                 AutomationProperties.Name="General settings">
          <ListBoxItem Content="Desktop widget" />
          <ListBoxItem Content="Screenshots" />
        </ListBox>

        <TextBlock Margin="12,0,0,8" Style="{StaticResource SectionLabelText}" Text="Spotlight" />
        <ListBox x:Name="SpotlightNavigationListBox"
                 Style="{StaticResource NavigationListBox}"
                 SelectionChanged="HandleSpotlightNavigationSelectionChanged"
                 AutomationProperties.Name="Spotlight settings">
          <ListBoxItem Content="UUID" />
          <ListBoxItem Content="Password" />
          <ListBoxItem Content="JWT secret" />
          <ListBoxItem Content="Text tools" />
        </ListBox>
      </StackPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <ScrollViewer x:Name="SettingsContentScrollViewer" Padding="32,28,32,0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,20">
          <StackPanel x:Name="WidgetSettingsPanel">
            <StackPanel Style="{StaticResource PageHeader}">
              <TextBlock Style="{StaticResource TitleText}" Text="Desktop widget" />
              <TextBlock Margin="0,2,0,0"
                         Style="{StaticResource SecondaryText}"
                         Text="Behaviour and appearance of the always-on clock." />
            </StackPanel>

            <TextBlock Style="{StaticResource SettingsGroupHeading}" Text="Behaviour" />
            <Border Style="{StaticResource SettingsGroup}">
              <StackPanel>
                <controls:SettingRow Title="Run at startup"
                                     Description="Start WinUtil automatically when you sign in to Windows.">
                  <CheckBox x:Name="RunAtStartupCheckBox"
                            Style="{StaticResource SettingsCheckBox}"
                            AutomationProperties.Name="Run at startup" />
                </controls:SettingRow>
                <Border Style="{StaticResource CardDivider}" />
                <controls:SettingRow Title="Keep above other windows">
                  <CheckBox x:Name="KeepOnTopCheckBox"
                            Style="{StaticResource SettingsCheckBox}"
                            AutomationProperties.Name="Keep above other windows" />
                </controls:SettingRow>
                <Border Style="{StaticResource CardDivider}" />
                <controls:SettingRow Title="Show seconds">
                  <CheckBox x:Name="ShowSecondsCheckBox"
                            Style="{StaticResource SettingsCheckBox}"
                            AutomationProperties.Name="Show seconds" />
                </controls:SettingRow>
                <Border Style="{StaticResource CardDivider}" />
                <controls:SettingRow Title="Fade after"
                                     Description="Idle time before the widget dims to its faded opacity.">
                  <ComboBox x:Name="AutoHideDelayComboBox"
                            Style="{StaticResource SettingsComboBox}"
                            AutomationProperties.Name="Fade after">
                    <ComboBoxItem Content="10 seconds" />
                    <ComboBoxItem Content="20 seconds" />
                  </ComboBox>
                </controls:SettingRow>
              </StackPanel>
            </Border>

            <TextBlock Margin="0,28,0,8"
                       Style="{StaticResource SubtitleText}"
                       Text="Appearance" />
            <Border Style="{StaticResource SettingsGroup}">
              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="248" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <StackPanel Margin="0,0,0,18">
                    <Grid>
                      <TextBlock Style="{StaticResource BaseText}" Text="Widget opacity" />
                      <TextBlock x:Name="OpacityValueText"
                                 HorizontalAlignment="Right"
                                 Style="{StaticResource SliderValueText}"
                                 Text="100%" />
                    </Grid>
                    <Slider x:Name="OpacitySlider"
                            Margin="0,8,0,0"
                            Minimum="{StaticResource MinimumWidgetOpacity}"
                            Maximum="{StaticResource MaximumOpacity}"
                            TickFrequency="{StaticResource OpacityTickFrequency}"
                            IsSnapToTickEnabled="True"
                            Style="{StaticResource SettingsSlider}"
                            ValueChanged="HandleOpacityValueChanged"
                            AutomationProperties.Name="Widget opacity" />
                  </StackPanel>
                  <StackPanel Margin="0,0,0,18">
                    <Grid>
                      <TextBlock Style="{StaticResource BaseText}" Text="Background opacity" />
                      <TextBlock x:Name="BackgroundOpacityValueText"
                                 HorizontalAlignment="Right"
                                 Style="{StaticResource SliderValueText}"
                                 Text="100%" />
                    </Grid>
                    <Slider x:Name="BackgroundOpacitySlider"
                            Margin="0,8,0,0"
                            Minimum="{StaticResource MinimumBackgroundOpacity}"
                            Maximum="{StaticResource MaximumOpacity}"
                            TickFrequency="{StaticResource OpacityTickFrequency}"
                            IsSnapToTickEnabled="True"
                            Style="{StaticResource SettingsSlider}"
                            ValueChanged="HandleBackgroundOpacityValueChanged"
                            AutomationProperties.Name="Background opacity" />
                  </StackPanel>
                  <StackPanel>
                    <Grid>
                      <TextBlock Style="{StaticResource BaseText}" Text="Idle opacity" />
                      <TextBlock x:Name="FadedOpacityValueText"
                                 HorizontalAlignment="Right"
                                 Style="{StaticResource SliderValueText}"
                                 Text="10%" />
                    </Grid>
                    <Slider x:Name="FadedOpacitySlider"
                            Margin="0,8,0,0"
                            Minimum="{StaticResource MinimumFadedOpacity}"
                            Maximum="{StaticResource MaximumFadedOpacity}"
                            TickFrequency="{StaticResource OpacityTickFrequency}"
                            IsSnapToTickEnabled="True"
                            Style="{StaticResource SettingsSlider}"
                            ValueChanged="HandleFadedOpacityValueChanged"
                            AutomationProperties.Name="Faded opacity" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <Border Background="{StaticResource SurfaceRaisedBrush}"
                          Padding="12" CornerRadius="{StaticResource ControlCornerRadius}">
                    <Border x:Name="WidgetPreview" Padding="14,12" CornerRadius="{StaticResource ControlCornerRadius}"
                            AutomationProperties.Name="Widget appearance preview">
                      <Border.Background>
                        <SolidColorBrush Color="{StaticResource Ink900}"
                                         Opacity="{Binding ElementName=BackgroundOpacitySlider, Path=Value}" />
                      </Border.Background>
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Opacity" Value="{Binding ElementName=OpacitySlider, Path=Value}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=PreviewIdleCheckBox, Path=IsChecked}" Value="True">
                              <Setter Property="Opacity" Value="{Binding ElementName=FadedOpacitySlider, Path=Value}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <StackPanel>
                        <TextBlock Style="{StaticResource CaptionText}" Text="Friday, 16 October" />
                        <TextBlock x:Name="WidgetPreviewTimeText" Margin="0,1,0,12"
                                   FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Text" Value="10:24" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=ShowSecondsCheckBox, Path=IsChecked}" Value="True">
                                  <Setter Property="Text" Value="10:24:36" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <Grid Margin="0,0,0,8">
                          <TextBlock Style="{StaticResource CaptionText}" Text="Laptop battery" />
                          <TextBlock HorizontalAlignment="Right" Style="{StaticResource CaptionText}" Text="87%" />
                        </Grid>
                        <Border Style="{StaticResource CardDivider}" />
                        <TextBlock Margin="0,8,0,3" Style="{StaticResource CaptionText}" Text="Speakers" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="Microphone array" />
                      </StackPanel>
                    </Border>
                  </Border>
                  <CheckBox x:Name="PreviewIdleCheckBox" Margin="0,10,0,0"
                            Style="{StaticResource SettingsCheckBox}" Content="Preview idle state" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>

          <StackPanel x:Name="ScreenshotSettingsPanel" Visibility="Collapsed">
            <StackPanel Style="{StaticResource PageHeader}">
              <TextBlock Style="{StaticResource TitleText}" Text="Screenshots" />
              <TextBlock Margin="0,2,0,0"
                         Style="{StaticResource SecondaryText}"
                         Text="Annotate Windows screenshots in WinUtil." />
            </StackPanel>
            <TextBlock Style="{StaticResource SettingsGroupHeading}" Text="Capture" />
            <Border Style="{StaticResource SettingsGroup}">
              <StackPanel>
                <controls:SettingRow Title="Open editor after a screenshot"
                                     Description="Use Win+Shift+S to capture an area, then edit it in WinUtil.">
                  <CheckBox x:Name="OpenScreenshotEditorCheckBox"
                            Style="{StaticResource SettingsCheckBox}"
                            AutomationProperties.Name="Open editor after a screenshot" />
                </controls:SettingRow>
              </StackPanel>
            </Border>
            <TextBlock Margin="0,28,0,8" Style="{StaticResource SubtitleText}" Text="In the editor" />
            <Border Style="{StaticResource SettingsGroup}">
              <StackPanel Margin="0,14,0,0">
                <TextBlock Style="{StaticResource BaseText}"
                           Text="Arrows, shapes, text and area blur" />
                <TextBlock Margin="0,5,0,0" Style="{StaticResource SecondaryText}"
                           Text="Copy the finished image or save a PNG at its original resolution." />
                <TextBlock Margin="0,16,0,0" Style="{StaticResource SecondaryText}"
                           Text="Your colour, line width, text size and blur strength are remembered when you close the editor." />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="UuidSettingsPanel" Visibility="Collapsed">
            <StackPanel Style="{StaticResource PageHeader}">
              <TextBlock Style="{StaticResource TitleText}" Text="UUID" />
              <TextBlock Margin="0,2,0,0"
                         Style="{StaticResource SecondaryText}"
                         Text="Choose the UUID version generated by Spotlight." />
            </StackPanel>
            <TextBlock Style="{StaticResource SettingsGroupHeading}" Text="Output" />
            <Border Style="{StaticResource SettingsGroup}">
              <StackPanel>
                <controls:SettingRow Title="UUID version"
                                     Description="Version 7 sorts by creation time; Version 4 is random.">
                  <ComboBox x:Name="UuidVersionComboBox"
                            MinWidth="180"
                            Style="{StaticResource SettingsComboBox}"
                            AutomationProperties.Name="UUID version">
                    <ComboBoxItem Content="Version 4 — random" />
                    <ComboBoxItem Content="Version 7 — ordered" />
                  </ComboBox>
                </controls:SettingRow>
                <Border Style="{StaticResource CardDivider}" />
                <controls:SettingRow Title="Global shortcut"
                                     Description="Runs Generate UUID from any app and overrides the matching app shortcut."
                                     Content="{Binding Shortcuts[uuid]}" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="PasswordSettingsPanel" Visibility="Collapsed">
            <StackPanel Style="{StaticResource PageHeader}">
              <TextBlock Style="{StaticResource TitleText}" Text="Password" />
              <TextBlock Margin="0,2,0,0"
                         Style="{StaticResource SecondaryText}"
                         Text="Choose the length and characters generated by Spotlight." />
            </StackPanel>
            <TextBlock Style="{StaticResource SettingsGroupHeading}" Text="Output" />
            <Border Style="{StaticResource SettingsGroup}">
              <StackPanel>
                <StackPanel Style="{StaticResource SliderRow}">
                  <Grid>
                    <TextBlock Style="{StaticResource BaseText}" Text="Length" />
                    <TextBlock x:Name="PasswordLengthValueText"
                               HorizontalAlignment="Right"
                               Style="{StaticResource SliderValueText}"
                               Text="20 characters" />
                  </Grid>
                  <Slider x:Name="PasswordLengthSlider"
                          Margin="0,6,0,0"
                          Minimum="{StaticResource MinimumPasswordLength}"
                          Maximum="{StaticResource MaximumPasswordLength}"
                          TickFrequency="1"
                          IsSnapToTickEnabled="True"
                          Style="{StaticResource SettingsSlider}"
                          ValueChanged="HandlePasswordLengthValueChanged"
                          AutomationProperties.Name="Password length" />
                </StackPanel>
                <Border Style="{StaticResource CardDivider}" />
                <StackPanel Margin="0,10">
                  <TextBlock Style="{StaticResource BaseText}" Text="Include characters" />
                  <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="8" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="PasswordIncludesUppercaseCheckBox"
                              Style="{StaticResource SettingsCheckBox}"
                              Content="Uppercase (A–Z)"
                              Checked="HandlePasswordCharacterSetChanged"
                              Unchecked="HandlePasswordCharacterSetChanged" />
                    <CheckBox x:Name="PasswordIncludesLowercaseCheckBox"
                              Grid.Column="1"
                              Style="{StaticResource SettingsCheckBox}"
                              Content="Lowercase (a–z)"
                              Checked="HandlePasswordCharacterSetChanged"
                              Unchecked="HandlePasswordCharacterSetChanged" />
                    <CheckBox x:Name="PasswordIncludesDigitsCheckBox"
                              Grid.Row="2"
                              Style="{StaticResource SettingsCheckBox}"
                              Content="Numbers (2–9)"
                              Checked="HandlePasswordCharacterSetChanged"
                              Unchecked="HandlePasswordCharacterSetChanged" />
                    <CheckBox x:Name="PasswordIncludesSymbolsCheckBox"
                              Grid.Row="2"
                              Grid.Column="1"
                              Style="{StaticResource SettingsCheckBox}"
                              Content="Symbols (! @ # $ - _)"
                              Checked="HandlePasswordCharacterSetChanged"
                              Unchecked="HandlePasswordCharacterSetChanged" />
                  </Grid>
                  <TextBlock x:Name="PasswordCharacterSetErrorText"
                             Margin="0,8,0,0"
                             Style="{StaticResource ErrorText}"
                             Text="Select at least one character group."
                             Visibility="Collapsed" />
                </StackPanel>
                <Border Style="{StaticResource CardDivider}" />
                <controls:SettingRow Title="Global shortcut"
                                     Description="Runs Generate password from any app and overrides the matching app shortcut."
                                     Content="{Binding Shortcuts[password]}" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="JwtSecretSettingsPanel" Visibility="Collapsed">
            <StackPanel Style="{StaticResource PageHeader}">
              <TextBlock Style="{StaticResource TitleText}" Text="JWT secret" />
              <TextBlock Margin="0,2,0,0"
                         Style="{StaticResource SecondaryText}"
                         Text="Choose the entropy for the Base64URL secret generated by Spotlight." />
            </StackPanel>
            <TextBlock Style="{StaticResource SettingsGroupHeading}" Text="Output" />
            <Border Style="{StaticResource SettingsGroup}">
              <StackPanel>
                <controls:SettingRow Title="Secret strength"
                                     Description="256-bit is suitable for HS256; choose a larger value only if your service needs it.">
                  <ComboBox x:Name="JwtSecretStrengthComboBox"
                            MinWidth="180"
                            Style="{StaticResource SettingsComboBox}"
                            AutomationProperties.Name="Secret strength">
                    <ComboBoxItem Content="256-bit — recommended" />
                    <ComboBoxItem Content="384-bit" />
                    <ComboBoxItem Content="512-bit" />
                  </ComboBox>
                </controls:SettingRow>
                <Border Style="{StaticResource CardDivider}" />
                <controls:SettingRow Title="Global shortcut"
                                     Description="Runs Generate JWT secret from any app and overrides the matching app shortcut."
                                     Content="{Binding Shortcuts[jwt-secret]}" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="TextToolsSettingsPanel" Visibility="Collapsed">
            <StackPanel Style="{StaticResource PageHeader}">
              <TextBlock Style="{StaticResource TitleText}" Text="Text tools" />
              <TextBlock Margin="0,2,0,0"
                         Style="{StaticResource SecondaryText}"
                         Text="Transform selected text in the active app. Each shortcut overrides the matching app command." />
            </StackPanel>

            <ItemsControl Focusable="False" ItemsSource="{Binding TextToolGroups}" />
          </StackPanel>

          <TextBlock x:Name="ShortcutErrorText"
                     Margin="0,12,0,0"
                     Style="{StaticResource ErrorText}"
                     Visibility="Collapsed" />
          <TextBlock x:Name="StartupErrorText"
                     Margin="0,12,0,0"
                     Style="{StaticResource ErrorText}"
                     Visibility="Collapsed" />
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="1"
              Padding="32,14"
              Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource DividerBrush}"
              BorderThickness="0,1,0,0">
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <Button Margin="0,0,8,0"
                  IsCancel="True"
                  Style="{StaticResource SecondaryButton}"
                  Content="Cancel"
                  Click="HandleCancel" />
          <Button IsDefault="True"
                  Style="{StaticResource PrimaryButton}"
                  Content="Save changes"
                  Click="HandleSave" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
