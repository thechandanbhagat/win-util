<Window x:Class="WinUtil.Views.SpotlightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="WinUtil command palette"
        Width="680"
        MinHeight="126"
        MaxHeight="520"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Deactivated="HandleDeactivated"
        PreviewKeyDown="HandlePreviewKeyDown">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <sys:Double x:Key="ActionResultsMaximumHeight">264</sys:Double>
    <Style x:Key="CommandResultItem" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="ResultBorder"
                    Padding="{TemplateBinding Padding}"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    CornerRadius="10">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ResultBorder" Property="Background" Value="{StaticResource SurfaceInteractiveBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ResultBorder" Property="Background" Value="{StaticResource AccentMutedBrush}" />
                <Setter TargetName="ResultBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ResultBorder" Property="BorderBrush" Value="{StaticResource TextPrimaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Margin="16"
          Padding="20"
          Background="{StaticResource SurfaceBrush}"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="18"
          Effect="{StaticResource ElevatedShadow}">
    <StackPanel>
      <Border
              Height="56"
              Background="{StaticResource SurfaceRaisedBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="12">
        <Border.Style>
          <Style TargetType="Border">
            <Style.Triggers>
              <DataTrigger Binding="{Binding ElementName=CommandTextBox, Path=IsKeyboardFocused}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="2" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid Margin="16,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center"
                     FontFamily="Cascadia Mono"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource AccentBrush}"
                     Text=">_" />
          <Grid Grid.Column="1">
            <TextBox x:Name="CommandTextBox"
                     Padding="0"
                     VerticalContentAlignment="Center"
                     Background="Transparent"
                     BorderThickness="0"
                     CaretBrush="{StaticResource AccentBrush}"
                     FontFamily="Segoe UI Variable Text"
                     FontSize="17"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Search tools" />
            <TextBlock VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       FontSize="17"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Search a tool or type a command">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasQuery}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </Grid>
      </Border>

      <Border Margin="0,8,0,0"
              Padding="12"
              Background="{StaticResource SurfaceRaisedBrush}"
              BorderBrush="{StaticResource ErrorBrush}"
              BorderThickness="1"
              CornerRadius="10"
              Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
        <TextBlock Foreground="{StaticResource ErrorBrush}"
                   TextWrapping="Wrap"
                   Text="{Binding ErrorMessage}" />
      </Border>

      <Grid Margin="0,12,0,0"
            Visibility="{Binding HasQuery, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="12" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
          <ListBox x:Name="ActionResultsListBox"
                   MaxHeight="{StaticResource ActionResultsMaximumHeight}"
                   Padding="0"
                   Background="Transparent"
                   BorderThickness="0"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   ItemsSource="{Binding MatchingActions}"
                   ItemContainerStyle="{StaticResource CommandResultItem}"
                   SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   Visibility="{Binding HasMatches, Converter={StaticResource BooleanToVisibilityConverter}}"
                   MouseDoubleClick="HandleActionDoubleClick"
                   AutomationProperties.Name="Matching tools">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Width="28"
                          Height="28"
                          VerticalAlignment="Top"
                          Background="{StaticResource SurfaceInteractiveBrush}"
                          CornerRadius="8">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Cascadia Mono"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               Text="&gt;" />
                  </Border>
                  <StackPanel Grid.Column="1">
                    <TextBlock FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="{Binding Title}" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="{Binding Description}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Border Grid.Column="2"
                          Padding="7,3"
                          VerticalAlignment="Center"
                          Background="{StaticResource SurfaceBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          CornerRadius="5">
                    <TextBlock FontFamily="Cascadia Mono"
                               FontSize="10"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="ENTER" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel HorizontalAlignment="Center"
                      Margin="0,20"
                      Visibility="Collapsed">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding HasQuery}" Value="True" />
                      <Condition Binding="{Binding HasMatches}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock HorizontalAlignment="Center"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Text="No matching tools" />
            <TextBlock Margin="0,4,0,0"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Try uuid or password." />
          </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Padding="0,12,0,0"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Commands insert results or replace your selected text." />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <TextBlock FontFamily="Cascadia Mono"
                         FontSize="11"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         Text="↑↓ navigate" />
              <TextBlock Margin="12,0,0,0"
                         FontFamily="Cascadia Mono"
                         FontSize="11"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         Text="↵ run" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </StackPanel>
  </Border>
</Window>
