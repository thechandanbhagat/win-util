<Window x:Class="WinUtil.Views.ScreenshotEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screenshot — WinUtil" Width="1120" Height="800" MinWidth="800" MinHeight="560"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource BodyFont}" FontSize="{StaticResource FontSizeBody}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        PreviewKeyDown="HandlePreviewKeyDown">
  <Window.Resources>
    <Style x:Key="ToolButton" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="42" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ToolTipService.ShowDuration" Value="10000" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="ToolBorder" Background="{TemplateBinding Background}"
                    BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ToolBorder" Property="Background" Value="{StaticResource SurfaceInteractiveBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ToolBorder" Property="Background" Value="{StaticResource AccentMutedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ToolBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ToolIcon" TargetType="Path">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
      <Setter Property="StrokeThickness" Value="1.6" />
      <Setter Property="StrokeStartLineCap" Value="Round" />
      <Setter Property="StrokeEndLineCap" Value="Round" />
    </Style>
    <Style x:Key="ZoomButton" TargetType="RadioButton" BasedOn="{StaticResource ToolButton}">
      <Setter Property="Width" Value="Auto" />
      <Setter Property="Height" Value="26" />
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="CommandIconButton" TargetType="Button" BasedOn="{StaticResource CompactSecondaryButton}">
      <Setter Property="Width" Value="34" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style x:Key="EditorOption" TargetType="ComboBox" BasedOn="{StaticResource SettingsComboBox}">
      <Setter Property="MinWidth" Value="84" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Margin" Value="0,0,18,0" />
      <Setter Property="SelectedValuePath" Value="Tag" />
    </Style>
    <Style x:Key="OptionLabel" TargetType="Label">
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="Padding" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="56" />
      <RowDefinition Height="*" />
      <RowDefinition Height="32" />
    </Grid.RowDefinitions>
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="14,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="UndoButton" Content="&#xE7A7;" Style="{StaticResource CommandIconButton}"
                  AutomationProperties.Name="Undo" ToolTip="Undo (Ctrl+Z)" Click="HandleUndo" />
          <Button x:Name="RedoButton" Content="&#xE7A6;" Style="{StaticResource CommandIconButton}"
                  AutomationProperties.Name="Redo" ToolTip="Redo (Ctrl+Y)" Click="HandleRedo" />
          <Border Width="1" Height="20" Background="{StaticResource DividerBrush}" Margin="12,0,18,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Screenshot" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock x:Name="ImageDetailsText" Margin="14,0,12,0" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="SaveButton" Content="Save PNG" Style="{StaticResource SecondaryButton}"
                  ToolTip="Save edited image (Ctrl+S)" Click="HandleSave" Margin="0,0,8,0" />
          <Button x:Name="CopyButton" Content="Copy image" Style="{StaticResource PrimaryButton}"
                  ToolTip="Copy edited image (Ctrl+C)" Click="HandleCopy" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="64" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
        <StackPanel Margin="10,12,10,0">
          <RadioButton x:Name="ArrowTool" GroupName="EditorTool" Tag="Arrow" IsChecked="True" Style="{StaticResource ToolButton}"
                       AutomationProperties.Name="Arrow" ToolTip="Arrow (A)" Checked="HandleToolChecked">
            <Path Style="{StaticResource ToolIcon}" Data="M3,19 L19,3 M7,3 L19,3 L19,15" />
          </RadioButton>
          <RadioButton x:Name="RectangleTool" GroupName="EditorTool" Tag="Rectangle" Style="{StaticResource ToolButton}"
                       AutomationProperties.Name="Rectangle" ToolTip="Rectangle (R)" Checked="HandleToolChecked">
            <Path Style="{StaticResource ToolIcon}" Data="M3,4 L19,4 L19,18 L3,18 Z" />
          </RadioButton>
          <RadioButton x:Name="EllipseTool" GroupName="EditorTool" Tag="Ellipse" Style="{StaticResource ToolButton}"
                       AutomationProperties.Name="Ellipse" ToolTip="Ellipse (E)" Checked="HandleToolChecked">
            <Path Style="{StaticResource ToolIcon}" Data="M3,11 A8,7 0 1 1 19,11 A8,7 0 1 1 3,11" />
          </RadioButton>
          <RadioButton x:Name="TextTool" GroupName="EditorTool" Tag="Text" Style="{StaticResource ToolButton}"
                       AutomationProperties.Name="Text" ToolTip="Text (T)" Checked="HandleToolChecked">
            <Path Style="{StaticResource ToolIcon}" Data="M4,4 L18,4 M11,4 L11,19 M7,19 L15,19" />
          </RadioButton>
          <Border Height="1" Background="{StaticResource DividerBrush}" Margin="5,4,5,10" />
          <RadioButton x:Name="BlurTool" GroupName="EditorTool" Tag="Blur" Style="{StaticResource ToolButton}"
                       AutomationProperties.Name="Blur area" ToolTip="Blur area (B)" Checked="HandleToolChecked">
            <Path Style="{StaticResource ToolIcon}" Data="M3,3 L19,3 L19,19 L3,19 Z M7,3 L7,19 M11,3 L11,19 M15,3 L15,19 M3,7 L19,7 M3,11 L19,11 M3,15 L19,15" StrokeDashArray="2,2" />
          </RadioButton>
        </StackPanel>
      </Border>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="46" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="18,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="ActiveToolText" Text="Arrow" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="76" Margin="0,0,18,0" />
            <StackPanel x:Name="ColorOptionPanel" Orientation="Horizontal">
              <Label Content="Colour" Target="{Binding ElementName=ColorComboBox}" Style="{StaticResource OptionLabel}" />
              <ComboBox x:Name="ColorComboBox" Style="{StaticResource EditorOption}" AutomationProperties.Name="Annotation colour" SelectionChanged="HandleOptionChanged" />
            </StackPanel>
            <StackPanel x:Name="StrokeOptionPanel" Orientation="Horizontal">
              <Label Content="Stroke" Target="{Binding ElementName=StrokeComboBox}" Style="{StaticResource OptionLabel}" />
              <ComboBox x:Name="StrokeComboBox" Style="{StaticResource EditorOption}" AutomationProperties.Name="Stroke width in pixels" SelectionChanged="HandleOptionChanged" />
            </StackPanel>
            <StackPanel x:Name="FontSizeOptionPanel" Orientation="Horizontal" Visibility="Collapsed">
              <Label Content="Size" Target="{Binding ElementName=FontSizeComboBox}" Style="{StaticResource OptionLabel}" />
              <ComboBox x:Name="FontSizeComboBox" Style="{StaticResource EditorOption}" AutomationProperties.Name="Text size in pixels" SelectionChanged="HandleOptionChanged" />
            </StackPanel>
            <StackPanel x:Name="BlurOptionPanel" Orientation="Horizontal" Visibility="Collapsed">
              <Label Content="Strength" Target="{Binding ElementName=BlurComboBox}" Style="{StaticResource OptionLabel}" />
              <ComboBox x:Name="BlurComboBox" Style="{StaticResource EditorOption}" AutomationProperties.Name="Blur strength in pixels" SelectionChanged="HandleOptionChanged" />
            </StackPanel>
          </StackPanel>
        </Border>
        <ScrollViewer x:Name="ImageScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" CanContentScroll="False">
          <ScrollViewer.Resources>
            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource Ink900}" />
          </ScrollViewer.Resources>
          <Grid x:Name="ImageViewport" Margin="28" Background="Transparent" MouseLeftButtonDown="HandleWorkspaceMouseDown">
            <Viewbox x:Name="ImageViewbox" Stretch="Uniform" StretchDirection="DownOnly">
              <Grid x:Name="ImageSurface" Background="Transparent" ClipToBounds="True">
                <Grid.Effect><DropShadowEffect Color="Black" Opacity="0.22" BlurRadius="16" ShadowDepth="3" /></Grid.Effect>
                <Image x:Name="ScreenshotImage" Stretch="Fill" IsHitTestVisible="False" />
                <Canvas x:Name="AnnotationCanvas" Background="Transparent" Cursor="Cross" Focusable="True"
                        MouseLeftButtonDown="HandleCanvasMouseDown" MouseMove="HandleCanvasMouseMove"
                        MouseLeftButtonUp="HandleCanvasMouseUp" LostMouseCapture="HandleLostMouseCapture" />
                <Canvas x:Name="TextOverlayCanvas" IsHitTestVisible="True">
                  <Border x:Name="TextInputPanel" Visibility="Collapsed" Background="#F2FFFFFF" BorderBrush="{StaticResource AccentStrongBrush}" BorderThickness="1" Padding="3">
                    <TextBox x:Name="AnnotationTextBox" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="28"
                             FontFamily="Segoe UI" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Text on screenshot" PreviewKeyDown="HandleTextEntryKeyDown"
                             ToolTip="Ctrl+Enter to place text. Escape to cancel." />
                  </Border>
                </Canvas>
              </Grid>
            </Viewbox>
          </Grid>
        </ScrollViewer>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,0,12,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <RadioButton x:Name="FitZoomButton" GroupName="Zoom" Content="Fit" IsChecked="True" Tag="Fit" Style="{StaticResource ZoomButton}" Checked="HandleZoomChanged" ToolTip="Fit screenshot to window" />
          <RadioButton x:Name="ActualSizeZoomButton" GroupName="Zoom" Content="100%" Tag="Actual" Style="{StaticResource ZoomButton}" Checked="HandleZoomChanged" ToolTip="Show screenshot at original pixel size" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
