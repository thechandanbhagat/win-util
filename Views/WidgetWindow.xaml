<Window x:Class="WinUtil.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:WinUtil.Models"
        Title="WinUtil widget"
        Width="316"
        MinHeight="180"
        SizeToContent="Height"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource BodyFont}"
        FontSize="{StaticResource FontSizeBody}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        MouseEnter="HandleMouseEnter"
        MouseLeave="HandleMouseLeave">
  <Window.Resources>
    <Style x:Key="DeviceGlyph" TargetType="TextBlock">
      <Setter Property="Width" Value="24" />
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="ProviderStatus" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
      <Style.Triggers>
        <Trigger Property="Text" Value="UNAVAILABLE">
          <Setter Property="Visibility" Value="Visible" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Border Margin="12"
          Padding="16,12"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="{StaticResource CardCornerRadius}"
          Effect="{StaticResource ElevatedShadow}"
          SnapsToDevicePixels="True"
          MouseLeftButtonDown="HandleDragMove">
    <Border.Background>
      <SolidColorBrush x:Name="WidgetBackgroundBrush" Color="{StaticResource Ink900}" />
    </Border.Background>
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="TimeText"
                   FontFamily="{StaticResource DisplayFont}"
                   FontSize="38"
                   FontWeight="Normal"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Text="00:00:00"
                   TextWrapping="NoWrap" />
        <TextBlock Grid.Column="1"
                   Margin="12,8,0,0"
                   VerticalAlignment="Top"
                   Style="{StaticResource CaptionText}"
                   Text="WinUtil" />
      </Grid>
      <TextBlock x:Name="DateText"
                 Margin="1,0,0,0"
                 Style="{StaticResource CaptionText}"
                 Text="Loading date" />
      <Border Margin="0,12,0,0"
              Padding="0,9,0,0"
              BorderBrush="{StaticResource DividerBrush}"
              BorderThickness="0,1,0,0">
        <StackPanel>
          <TextBlock x:Name="BatteryStatusText"
                     Style="{StaticResource ProviderStatus}"
                     Text="CHECKING"
                     ToolTip="Battery status could not be refreshed." />
          <TextBlock x:Name="BatteryEmptyText"
                     Margin="0,3,0,3"
                     Style="{StaticResource CaptionText}"
                     Text="No battery data available"
                     Visibility="Collapsed" />
          <ItemsControl x:Name="BatteryDevicesItemsControl" AutomationProperties.Name="Battery levels">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type models:BatteryDevice}">
                <Grid MinHeight="26">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource DeviceGlyph}" Text="&#xE83F;" ToolTip="Battery" />
                  <TextBlock Grid.Column="1"
                             VerticalAlignment="Center"
                             Text="{Binding Name}"
                             TextTrimming="CharacterEllipsis"
                             TextWrapping="NoWrap"
                             ToolTip="{Binding Name}" />
                  <TextBlock Grid.Column="2"
                             Margin="12,0,0,0"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource AccentBrush}"
                             Style="{StaticResource ValueText}"
                             Text="{Binding Percentage, StringFormat={}{0}%}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Margin="0,9,0,0"
              Padding="0,9,0,0"
              BorderBrush="{StaticResource DividerBrush}"
              BorderThickness="0,1,0,0">
        <StackPanel>
          <TextBlock x:Name="AudioStatusText"
                     Style="{StaticResource ProviderStatus}"
                     Text="CHECKING"
                     ToolTip="Audio devices could not be refreshed." />
          <Grid MinHeight="26">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource DeviceGlyph}" Text="&#xE767;" ToolTip="Audio output" />
            <TextBlock x:Name="OutputDeviceText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Text="Checking output device"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                       AutomationProperties.Name="Audio output" />
          </Grid>
          <Grid MinHeight="26">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource DeviceGlyph}" Text="&#xE720;" ToolTip="Audio input" />
            <TextBlock x:Name="InputDeviceText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Text="Checking input device"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                       AutomationProperties.Name="Audio input" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</Window>
