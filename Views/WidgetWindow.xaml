<Window x:Class="WinUtil.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:WinUtil.Models"
        Title="WinUtil widget"
        Width="320"
        MinHeight="180"
        SizeToContent="Height"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource BodyFont}"
        FontSize="{StaticResource FontSizeBody}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        MouseEnter="HandleMouseEnter"
        MouseLeave="HandleMouseLeave">
  <Border Margin="12"
          Padding="16,12"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="{StaticResource CardCornerRadius}"
          Effect="{StaticResource ElevatedShadow}"
          SnapsToDevicePixels="True"
          MouseLeftButtonDown="HandleDragMove">
    <Border.Background>
      <SolidColorBrush x:Name="WidgetBackgroundBrush"
                       Color="{StaticResource Ink900}" />
    </Border.Background>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="DateText"
                   VerticalAlignment="Center"
                   Style="{StaticResource SecondaryText}"
                   Text="Loading date" />
        <TextBlock Grid.Column="1"
                   VerticalAlignment="Center"
                   Style="{StaticResource CaptionText}"
                   Text="WinUtil" />
      </Grid>

      <TextBlock x:Name="TimeText"
                 Grid.Row="1"
                 Margin="0,2,0,0"
                 FontFamily="{StaticResource DisplayFont}"
                 FontSize="40"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource TextPrimaryBrush}"
                 Text="00:00:00" />

      <Border Grid.Row="2"
              Margin="0,12,0,0"
              Padding="0,10,0,0"
              BorderBrush="{StaticResource DividerBrush}"
              BorderThickness="0,1,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource SectionLabelText}"
                       Margin="0"
                       Text="Battery" />
            <TextBlock x:Name="BatteryStatusText"
                       Grid.Column="1"
                       Style="{StaticResource ValueText}"
                       FontSize="10"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="CHECKING" />
          </Grid>
          <TextBlock x:Name="BatteryEmptyText"
                     Grid.Row="1"
                     Margin="0,6,0,0"
                     Style="{StaticResource CaptionText}"
                     Text="No connected devices are reporting battery data."
                     Visibility="Collapsed" />
          <ItemsControl x:Name="BatteryDevicesItemsControl"
                        Grid.Row="1"
                        Margin="0,6,0,0"
                        AutomationProperties.Name="Battery levels">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type models:BatteryDevice}">
                <Grid Margin="0,0,12,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center"
                             Style="{StaticResource BaseText}"
                             FontSize="{StaticResource FontSizeCaption}"
                             Text="{Binding Name}"
                             TextTrimming="CharacterEllipsis"
                             TextWrapping="NoWrap"
                             ToolTip="{Binding Name}" />
                  <TextBlock Grid.Column="1"
                             Margin="8,0,0,0"
                             Style="{StaticResource ValueText}"
                             Text="{Binding Percentage, StringFormat={}{0}%}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>

      <Border Grid.Row="3"
              Margin="0,10,0,0"
              Padding="0,10,0,0"
              BorderBrush="{StaticResource DividerBrush}"
              BorderThickness="0,1,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Margin="0"
                       Style="{StaticResource SectionLabelText}"
                       Text="Audio" />
            <TextBlock x:Name="AudioStatusText"
                       Grid.Column="1"
                       Style="{StaticResource ValueText}"
                       FontSize="10"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="CHECKING" />
          </Grid>
          <Grid Grid.Row="1"
                Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Style="{StaticResource CaptionText}"
                       Text="Output" />
            <TextBlock x:Name="OutputDeviceText"
                       Grid.Column="1"
                       Margin="8,0,0,0"
                       HorizontalAlignment="Right"
                       Style="{StaticResource ValueText}"
                       Text="Checking output device"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
          </Grid>
          <Grid Grid.Row="2"
                Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Style="{StaticResource CaptionText}"
                       Text="Input" />
            <TextBlock x:Name="InputDeviceText"
                       Grid.Column="1"
                       Margin="8,0,0,0"
                       HorizontalAlignment="Right"
                       Style="{StaticResource ValueText}"
                       Text="Checking input device"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
