<Window x:Class="WinUtil.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:WinUtil.Models"
        Title="WinUtil widget"
        Width="392"
        MinHeight="272"
        SizeToContent="Height"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        MouseEnter="HandleMouseEnter"
        MouseLeave="HandleMouseLeave">
  <Border Margin="12"
          Padding="16"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="20"
          Effect="{StaticResource ElevatedShadow}"
          MouseLeftButtonDown="HandleDragMove">
    <Border.Background>
      <SolidColorBrush x:Name="WidgetBackgroundBrush"
                       Color="{StaticResource Ink900}" />
    </Border.Background>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Border Width="8"
                  Height="8"
                  Margin="0,0,8,0"
                  VerticalAlignment="Center"
                  Background="{StaticResource AccentBrush}"
                  CornerRadius="4" />
          <TextBlock VerticalAlignment="Center"
                     FontFamily="Cascadia Mono"
                     FontSize="10"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     Text="WINUTIL" />
          <TextBlock Margin="8,0,0,0"
                     VerticalAlignment="Center"
                     FontSize="10"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     Text="DESKTOP CLOCK" />
        </StackPanel>
        <Border Grid.Column="1"
                Padding="8,4"
                Background="{StaticResource SurfaceRaisedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="6"
                     Height="6"
                     Margin="0,0,5,0"
                     VerticalAlignment="Center"
                     Fill="{StaticResource SuccessBrush}" />
            <TextBlock FontFamily="Cascadia Mono"
                       FontSize="9"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="ACTIVE" />
          </StackPanel>
        </Border>
      </Grid>

      <StackPanel Grid.Row="1"
                  VerticalAlignment="Center">
        <TextBlock x:Name="TimeText"
                   FontFamily="Segoe UI Variable Display"
                   FontSize="46"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Text="00:00:00" />
        <Border Height="2"
                Margin="0,7,0,0"
                HorizontalAlignment="Left"
                Background="{StaticResource AccentBrush}"
                CornerRadius="1"
                Width="40" />
      </StackPanel>

      <Border Grid.Row="2"
              Margin="0,12,0,12"
              Padding="8"
              Background="{StaticResource SurfaceRaisedBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock FontFamily="Cascadia Mono"
                       FontSize="9"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="BATTERY" />
            <TextBlock x:Name="BatteryStatusText"
                       Grid.Column="1"
                       FontFamily="Cascadia Mono"
                       FontSize="9"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="CHECKING" />
          </Grid>
          <TextBlock x:Name="BatteryEmptyText"
                     Grid.Row="2"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     Text="No connected devices are reporting battery data."
                     TextWrapping="Wrap"
                     Visibility="Collapsed" />
          <ItemsControl x:Name="BatteryDevicesItemsControl"
                        Grid.Row="2"
                        AutomationProperties.Name="Battery levels">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type models:BatteryDevice}">
                <Grid Margin="0,0,8,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center"
                             FontSize="11"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             Text="{Binding Name}"
                             TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding Name}" />
                  <TextBlock Grid.Column="1"
                             Margin="8,0,0,0"
                             VerticalAlignment="Center"
                             FontFamily="Cascadia Mono"
                             FontSize="10"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource AccentBrush}"
                             Text="{Binding Percentage, StringFormat={}{0}%}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>

      <Border Grid.Row="3"
              Margin="0,0,0,12"
              Padding="8"
              Background="{StaticResource SurfaceRaisedBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock FontFamily="Cascadia Mono"
                       FontSize="9"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="AUDIO" />
            <TextBlock x:Name="AudioStatusText"
                       Grid.Column="1"
                       FontFamily="Cascadia Mono"
                       FontSize="9"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="CHECKING" />
          </Grid>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       FontSize="10"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Output" />
            <TextBlock x:Name="OutputDeviceText"
                       Grid.Column="1"
                       Margin="8,0,0,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Text="Checking output device"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
          </Grid>
          <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       FontSize="10"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Input" />
            <TextBlock x:Name="InputDeviceText"
                       Grid.Column="1"
                       Margin="8,0,0,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Text="Checking input device"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
          </Grid>
        </Grid>
      </Border>

      <Grid Grid.Row="4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="DateText"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="12"
                   Text="Loading date" />
        <TextBlock Grid.Column="1"
                   FontFamily="Cascadia Mono"
                   FontSize="9"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Text="LOCAL" />
      </Grid>
    </Grid>
  </Border>
</Window>
